# MongoDB Atlas connection string (Billionit cluster). Set this in Vercel project env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name for license records.
MONGODB_DB=oi_license

# Secret for admin endpoints (/api/issue, /api/revoke). Use a long random string.
ADMIN_SECRET=change-me-to-a-long-random-string
